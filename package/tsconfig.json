{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "noImplicitOverride": true,
    "paths": {"*": ["./src/*"]}
  },
  "include": ["src/**/*", "plugins/**/*", "worker-configuration.d.ts"]
}
